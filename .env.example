# Copy to .env and fill in. Never commit the real .env.
DB_PASSWORD=change-me-to-a-strong-password
# Must be BASE64. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Your public URL(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Only for the HTTPS setup (docker-compose.https.yml): your domain,
# e.g. smartcare-yourname.duckdns.org  (no https:// prefix)
DOMAIN=
